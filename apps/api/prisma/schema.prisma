generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254)
  // Optional: a user created via OIDC (Google/Microsoft) only has no local
  // password. AuthService.signIn already treats a null hash as a 401,
  // the same message as a wrong password (see password.ts's DUMMY_HASH).
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  posts      Post[]
  comments   Comment[]
  likes      Like[]
  identities OidcIdentity[]

  @@map("users")
}

// One row per (provider, external account) a user has linked. The
// @@unique([provider, providerSub]) below guarantees a given external
// account — not "a given provider" — can only ever be claimed by one user:
// a second login from that same external account resolves to its existing
// row, never a second one. It does NOT limit a user to one identity per
// provider — linking two different Google accounts to the same user, for
// instance, is a schema-level non-issue (nothing in this app's flows
// creates that today, but nothing here forbids it either). A user can also
// mix a local password with one or more OIDC identities.
model OidcIdentity {
  id          Int      @id @default(autoincrement())
  provider    String   @db.VarChar(20) // "google" | "microsoft"
  providerSub String   @map("provider_sub") @db.VarChar(255) // the id_token's `sub` claim, stable per provider
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
  @@map("oidc_identities")
}

model Post {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(160)
  title        String   @db.VarChar(120)
  excerpt      String   @db.VarChar(160)
  content      String
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  code         String?  @db.Text
  authorId     Int      @map("author_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Generated tsvector column for the Portuguese full-text search. Prisma
  // cannot express GENERATED ALWAYS AS, so the DDL for this column is written
  // by hand in the migration (see 20261005_create_posts_comments_likes).
  // It is declared here only so `migrate dev` does not read the column as
  // drift and try to drop it. Optional on purpose: that keeps it out of the
  // generated create/update inputs, which is right for a generated column.
  searchVector Unsupported("tsvector")? @map("search_vector")

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
  @@index([searchVector], type: Gin, map: "posts_search_vector_idx")
  @@map("posts")
}

model Comment {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(1000)
  postId    Int      @map("post_id")
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

// Composite primary key instead of a synthetic id: it gives the uniqueness
// constraint and the lookup index for free, and a like has no identity of its
// own. The column is user_id, not author_id — a like is not authored.
model Like {
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("likes")
}
