# development | test | production. Validated at boot (src/env.ts): it decides
# whether JWT_SECRET/CORS_ORIGINS are required and whether COOKIE_SECURE and
# SWAGGER_ENABLED default on or off.
NODE_ENV=development
# Copy to .env and use the POSTGRES_PASSWORD from the root .env.
DATABASE_URL=postgresql://codeconnect:troque-esta-senha@localhost:5432/codeconnect
# Used by the e2e tests, which truncate their tables. Never point it at DATABASE_URL.
TEST_DATABASE_URL=postgresql://codeconnect:troque-esta-senha@localhost:5432/codeconnect_test
# Optional in development/test; required (min. 32 characters) in production.
JWT_SECRET=
JWT_EXPIRES_IN=3600
# How long a "Lembrar-me" session lasts, in seconds. Defaults to 7 days.
REMEMBER_ME_EXPIRES_IN=604800
PORT=3000
# Number of reverse-proxy hops to trust for the client IP the rate limiter
# keys on (Express's `trust proxy`). 0 (default) means "no proxy, trust
# nothing". Never set this to `true`-like values beyond a hop count: trusting
# the whole X-Forwarded-For chain lets a client spoof its own IP and bypass
# the limiter entirely.
TRUST_PROXY=0
# Swagger UI (/api/docs) and the JSON doc (/api/docs-json). Defaults to on
# outside production, off in production (no guard can protect it — see
# CLAUDE.md — so gate it with this flag or put it behind a reverse proxy).
SWAGGER_ENABLED=
# Comma-separated web origins allowed by CORS. Defaults to the Vite dev origins;
# in production, without it, every browser origin is refused.
CORS_ORIGINS=http://localhost:5173

# Session cookie attributes. Leave COOKIE_SECURE unset in development/test:
# Chrome and Firefox accept a Secure cookie on http://localhost, but Safari
# and the e2e test agent (supertest) do not, so a cookie e2e test would fail
# as an unexplainable 401. It defaults to true in production.
COOKIE_SECURE=
# strict | lax | none. Use `lax` or `none` only if the web app and the API end
# up on different registrable domains in production (see CLAUDE.md).
COOKIE_SAMESITE=strict
# Leave unset unless the API and the web app share a parent domain
# (e.g. COOKIE_DOMAIN=.exemplo.com for api.exemplo.com + app.exemplo.com).
COOKIE_DOMAIN=
# Secret for the CSRF double-submit token. Defaults to JWT_SECRET if unset,
# so setting it is optional but recommended for key separation.
CSRF_SECRET=

# Login social via OIDC (Google/Microsoft) — see plan/LoginSocial.md. An
# optional feature on top of the password login above: leaving everything
# below unset is fine, GET /auth/oidc/:provider/start just redirects to
# /login?oidcError=1 instead of starting a real login (see
# OidcController.start) — the password form on that same page still works.
#
# Fixed, per-environment base URLs the OIDC redirect_uri and the post-login
# redirect are built from (never taken from the request). Default to the
# Vite/Nest dev ports if unset — but if you DO set GOOGLE_CLIENT_ID or
# MICROSOFT_CLIENT_ID below, env.ts then requires both of these explicitly
# in production: leaving them at their dev defaults there would silently
# build a redirect_uri/post-login redirect pointing at localhost.
API_ORIGIN=http://localhost:3000
WEB_APP_ORIGIN=http://localhost:5173
# From the Google Cloud Console / Entra ID App Registration for this
# environment. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: the App Registration also needs the optional claim `xms_edov`
# added under Token configuration, or every *new* login (account creation,
# auto-link) fails closed with /login?oidcError=1 — Entra ID's v2.0 endpoint
# doesn't reliably send `email_verified` on its own, and personal (MSA)
# accounts never do either way (see OidcService.verifyIdToken). Not optional
# polish: without it, the Microsoft button looks enabled but new logins never
# work. Check this in homologação before enabling the button in production.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Signs the short-lived linking_token used by POST /auth/oidc/link. Unlike
# the vars above, this one IS required in production (min. 32 characters) —
# it is cheap to generate regardless of whether OIDC credentials are
# configured, and a wrong default becomes a real account-linking forgery
# risk the moment they are. Never the same value as JWT_SECRET/CSRF_SECRET.
OIDC_LINKING_TOKEN_SECRET=
