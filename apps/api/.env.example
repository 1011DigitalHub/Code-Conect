# Copy to .env and use the POSTGRES_PASSWORD from the root .env.
DATABASE_URL=postgresql://codeconnect:troque-esta-senha@localhost:5432/codeconnect
# Used by the e2e tests, which truncate their tables. Never point it at DATABASE_URL.
TEST_DATABASE_URL=postgresql://codeconnect:troque-esta-senha@localhost:5432/codeconnect_test
# Optional in development; required in production.
JWT_SECRET=
JWT_EXPIRES_IN=3600
PORT=3000
# Comma-separated web origins allowed by CORS. Defaults to the Vite dev origins;
# in production, without it, every browser origin is refused.
CORS_ORIGINS=http://localhost:5173

# Session cookie attributes. Leave COOKIE_SECURE unset in development/test:
# Chrome and Firefox accept a Secure cookie on http://localhost, but Safari
# and the e2e test agent (supertest) do not, so a cookie e2e test would fail
# as an unexplainable 401. It defaults to true in production.
COOKIE_SECURE=
# strict | lax | none. Use `lax` or `none` only if the web app and the API end
# up on different registrable domains in production (see CLAUDE.md).
COOKIE_SAMESITE=strict
# Leave unset unless the API and the web app share a parent domain
# (e.g. COOKIE_DOMAIN=.exemplo.com for api.exemplo.com + app.exemplo.com).
COOKIE_DOMAIN=
# Secret for the CSRF double-submit token. Defaults to JWT_SECRET if unset,
# so setting it is optional but recommended for key separation.
CSRF_SECRET=
