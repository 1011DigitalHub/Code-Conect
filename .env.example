# Copy to .env and fill in. Used by docker-compose.yml.
POSTGRES_USER=codeconnect
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=codeconnect

# Only needed to run the api/web services themselves in Docker
# (docker compose up api web) — not for day-to-day development, where
# `pnpm dev` talks to this same postgres service directly. Separate from
# apps/api/.env's copies: those are for running the API outside a
# container, these are what the containerized api/web services read.
JWT_SECRET=
CORS_ORIGINS=http://localhost:8080
VITE_API_URL=http://localhost:3000

# Login social via OIDC (plan/LoginSocial.md) — optional, for the api
# service above. Leave the four credential vars unset to smoke-test api/web
# without it; the social buttons on the web service just fail at the
# provider. OIDC_LINKING_TOKEN_SECRET is different: the api service (built
# with NODE_ENV=production) always refuses to boot without it, regardless
# of whether the credentials above are set — generate one (min. 32
# characters, never the same as JWT_SECRET) even if you're not using OIDC.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OIDC_LINKING_TOKEN_SECRET=
