# Copy to .env and fill in. Used by docker-compose.yml.
POSTGRES_USER=codeconnect
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=codeconnect

# Only needed to run the api/web services themselves in Docker
# (docker compose up api web) — not for day-to-day development, where
# `pnpm dev` talks to this same postgres service directly. Separate from
# apps/api/.env's copies: those are for running the API outside a
# container, these are what the containerized api/web services read.
JWT_SECRET=
CORS_ORIGINS=http://localhost:8080
VITE_API_URL=http://localhost:3000

# Login social via OIDC (plan/LoginSocial.md) — for the api service above.
# Leave the four credential vars unset to smoke-test api/web without it;
# the social buttons on the web service just answer 404 (see
# OidcController.start). The single origin the OIDC callback redirects the
# browser back to — must be exactly one origin, unlike the comma-separated
# CORS_ORIGINS above, which is why it's its own var.
WEB_APP_ORIGIN=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# NOT optional, unlike the four vars above: the api service (built with
# NODE_ENV=production) always refuses to boot without this, regardless of
# whether OIDC credentials are set — generate one (min. 32 characters,
# never the same as JWT_SECRET) even if you're not using OIDC at all.
OIDC_LINKING_TOKEN_SECRET=
