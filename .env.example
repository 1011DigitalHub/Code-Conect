# Copy to .env and fill in. Used by docker-compose.yml.
POSTGRES_USER=codeconnect
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=codeconnect

# Only needed to run the api/web services themselves in Docker
# (docker compose up api web) — not for day-to-day development, where
# `pnpm dev` talks to this same postgres service directly. Separate from
# apps/api/.env's copies: those are for running the API outside a
# container, these are what the containerized api/web services read.
JWT_SECRET=
CORS_ORIGINS=http://localhost:8080
VITE_API_URL=http://localhost:3000
